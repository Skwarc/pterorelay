{
  "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
  "id": "pterosync-discord",
  "name": "PteroSync Discord",
  "version": "0.5.0-beta.4",
  "description": "Discord management and game integration for Pterodactyl servers.",
  "author": "PteroSync contributors",
  "requires": {
    "panel": "^2.0.0-dev",
    "sdk": "^2.0.0-beta.4",
    "php": "^8.3"
  },
  "provider": "PteroSync\\PteroSyncProvider",
  "autoload": {
    "PteroSync\\": "src"
  },
  "routes": {
    "root": ["pterosync-agent"]
  },
  "ui": {
    "entry": "dist/client.js",
    "mode": "native",
    "prefix": "psync",
    "screens": [
      {
        "id": "account-settings",
        "area": "account",
        "path": "pterosync",
        "nav": { "label": "PteroSync", "icon": "settings" }
      },
      {
        "id": "server-settings",
        "area": "server",
        "path": "discord",
        "permission": ["ext.pterosync-discord.view"],
        "nav": { "label": "Discord", "icon": "message-circle" }
      },
      {
        "id": "admin-settings",
        "area": "admin",
        "path": "pterosync",
        "nav": { "label": "PteroSync", "icon": "settings" }
      }
    ]
  }
}
